<odoo>
    <record id="credit_opening_import_form" model="ir.ui.view">
        <field name="name">l10n_br_pis_cofins.credit.opening.import.form</field>
        <field name="model">l10n_br_pis_cofins.credit.opening.import</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="company_id" groups="base.group_multi_company" />
                    <field name="file" filename="filename" />
                    <field name="filename" invisible="1" />
                </group>
                <div class="alert alert-info" role="alert">
                    Escolha o arquivo da &#250;ltima EFD Contribui&#231;&#245;es transmitida pelo
                    sistema anterior. O saldo de cada per&#237;odo de origem e tipo de
                    cr&#233;dito (registros 1100 e 1500) vira um lan&#231;amento de saldo
                    inicial, v&#225;lido a partir do m&#234;s seguinte ao do arquivo.
                </div>
                <footer>
                    <button
                        name="action_import"
                        type="object"
                        string="Importar"
                        class="btn-primary"
                    />
                    <button string="Cancelar" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="credit_opening_import_action" model="ir.actions.act_window">
        <field name="name">Importar saldo inicial da EFD Contribui&#231;&#245;es</field>
        <field name="res_model">l10n_br_pis_cofins.credit.opening.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="credit_opening_tree" model="ir.ui.view">
        <field name="name">l10n_br_pis_cofins.credit.opening.list</field>
        <field name="model">l10n_br_pis_cofins.credit.opening</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id" groups="base.group_multi_company" />
                <field name="tax_domain" />
                <field name="origin_period" />
                <field name="cod_cred" />
                <field name="orig_cred" />
                <field name="amount" sum="Total" />
                <field name="used_before" sum="Total" />
                <field name="balance" sum="Total" />
                <field name="cutoff_date" />
                <field name="currency_id" invisible="1" />
            </list>
        </field>
    </record>

    <record id="credit_opening_form" model="ir.ui.view">
        <field name="name">l10n_br_pis_cofins.credit.opening.form</field>
        <field name="model">l10n_br_pis_cofins.credit.opening</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Informe aqui o cr&#233;dito de PIS e de COFINS que a empresa j&#225;
                        tinha acumulado antes de usar o sistema. Os valores v&#234;m da
                        &#250;ltima EFD Contribui&#231;&#245;es transmitida pelo sistema anterior,
                        nos registros 1100 (PIS) e 1500 (COFINS): um lan&#231;amento para
                        cada per&#237;odo de origem e tipo de cr&#233;dito. Esse saldo &#233; usado
                        primeiro (&#233; o cr&#233;dito mais antigo) e a apura&#231;&#227;o do primeiro
                        m&#234;s no sistema parte dele. O sistema n&#227;o faz lan&#231;amento
                        cont&#225;bil: o saldo de impostos a recuperar deve estar no
                        balan&#231;o de abertura.
                    </div>
                    <group>
                        <group>
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="tax_domain" />
                            <field name="cutoff_date" />
                        </group>
                        <group>
                            <field name="origin_period" />
                            <field name="cod_cred" />
                            <field name="orig_cred" />
                            <field
                                name="cnpj_suc"
                                invisible="orig_cred != '02'"
                                required="orig_cred == '02'"
                            />
                        </group>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1" />
                        <field name="amount" />
                        <field name="used_before" />
                        <field name="balance" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="credit_opening_action" model="ir.actions.act_window">
        <field name="name">Saldo inicial de cr&#233;dito de PIS/COFINS</field>
        <field name="res_model">l10n_br_pis_cofins.credit.opening</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_credit_opening_import"
        name="Importar saldo inicial da EFD Contribui&#231;&#245;es"
        parent="account.menu_finance_entries_actions"
        action="credit_opening_import_action"
        groups="account.group_account_manager"
        sequence="93"
    />

    <menuitem
        id="menu_credit_opening"
        name="Saldo inicial de cr&#233;dito de PIS/COFINS"
        parent="account.menu_finance_entries_actions"
        action="credit_opening_action"
        groups="account.group_account_manager"
        sequence="92"
    />
</odoo>
